        }
      ]
    },
    {
      "name": "gcc-asan",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-asan"
        },
        {
          "type": "build",
          "name": "gcc-asan"
        },
        {
          "type": "test",
          "name": "gcc-asan"
        }
      ]
    },
    {
      "name": "clang-debug",
      "steps": [
        {
          "type": "configure",
          "name": "clang-debug"
        },
        {
          "type": "build",
          "name": "clang-debug"
        },
        {
          "type": "test",
          "name": "clang-debug"
        }
      ]
    },
    {
      "name": "clang-release",
      "steps": [
        {
          "type": "configure",
          "name": "clang-release"
        },
        {
