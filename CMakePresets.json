{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "ninja-gcc",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ninja-clang",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc",
      "inherits": "msvc-base"
    },
    {
      "name": "msvc-asan",
      "inherits": "msvc-base",
      "cacheVariables": {
        "ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "gcc-debug",
      "inherits": "ninja-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-release",
      "inherits": "ninja-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-asan",
      "inherits": "ninja-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "ninja-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-release",
      "inherits": "ninja-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-asan",
      "inherits": "ninja-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-only",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "nix-only",
      "hidden": true,
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "win-only",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "inherits": "win-only",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "msvc-asan",
      "inherits": "win-only",
      "configurePreset": "msvc-asan",
      "configuration": "Debug"
    },
    {
      "name": "gcc-debug",
      "inherits": "nix-only",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "inherits": "nix-only",
      "configurePreset": "gcc-release"
    },
    {
      "name": "gcc-asan",
      "inherits": "nix-only",
      "configurePreset": "gcc-asan"
    },
    {
      "name": "clang-debug",
      "inherits": "nix-only",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release",
      "inherits": "nix-only",
      "configurePreset": "clang-release"
    },
    {
      "name": "clang-asan",
      "inherits": "nix-only",
      "configurePreset": "clang-asan"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-only",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "nix-only",
      "hidden": true,
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": [
        "test-base",
        "win-only"
      ],
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "inherits": [
        "test-base",
        "win-only"
      ],
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "msvc-asan",
      "inherits": [
        "test-base",
        "win-only"
      ],
      "configurePreset": "msvc-asan",
      "configuration": "Debug"
    },
    {
      "name": "gcc-debug",
      "inherits": [
        "test-base",
        "nix-only"
      ],
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "inherits": [
        "test-base",
        "nix-only"
      ],
      "configurePreset": "gcc-release"
    },
    {
      "name": "gcc-asan",
      "inherits": [
        "test-base",
        "nix-only"
      ],
      "configurePreset": "gcc-asan"
    },
    {
      "name": "clang-debug",
      "inherits": [
        "test-base",
        "nix-only"
      ],
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release",
      "inherits": [
        "test-base",
        "nix-only"
      ],
      "configurePreset": "clang-release"
    },
    {
      "name": "clang-asan",
      "inherits": [
        "test-base",
        "nix-only"
      ],
      "configurePreset": "clang-asan"
    }
  ],
  "workflowPresets": [
    {
      "name": "msvc-debug",
      "steps": [
        {
          "type": "configure",
          "name": "msvc"
        },
        {
          "type": "build",
          "name": "msvc-debug"
        },
        {
          "type": "test",
          "name": "msvc-debug"
        }
      ]
    },
    {
      "name": "msvc-release",
      "steps": [
        {
          "type": "configure",
          "name": "msvc"
        },
        {
          "type": "build",
          "name": "msvc-release"
        },
        {
          "type": "test",
          "name": "msvc-release"
        }
      ]
    },
    {
      "name": "msvc-asan",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-asan"
        },
        {
          "type": "build",
          "name": "msvc-asan"
        },
        {
          "type": "test",
          "name": "msvc-asan"
        }
      ]
    },
    {
      "name": "gcc-debug",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-debug"
        },
        {
          "type": "build",
          "name": "gcc-debug"
        },
        {
          "type": "test",
          "name": "gcc-debug"
        }
      ]
    },
    {
      "name": "gcc-release",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-release"
        },
        {
          "type": "build",
          "name": "gcc-release"
        },
        {
          "type": "test",
